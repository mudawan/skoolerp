# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUST_PROXY: Set to "true" ONLY if this app is running behind a reverse
# proxy you control (e.g. the nginx config in nginx.conf). This tells
# Express to read the real client IP from the X-Forwarded-For header rather
# than the socket's peer address, which matters for rate limiting and audit
# logging. Do NOT set this if the app is directly internet-facing (e.g. the
# bare docker-compose.yml setup with no reverse proxy in front) — doing so
# would let any client spoof their IP via X-Forwarded-For and bypass rate
# limits.
TRUST_PROXY=false

# DATABASE_URL: PostgreSQL connection string for production database.
# Example: DATABASE_URL="postgres://postgres:password@localhost:5432/school_db"
# NOTE: if you are running via `docker-compose.yml`, do NOT set this directly —
# it is constructed automatically from POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB below. Only set DATABASE_URL yourself if you are running the
# app outside of docker-compose (e.g. against a managed/external database).
DATABASE_URL=

# --- docker-compose Postgres credentials ---
# Required when running via `docker-compose up`. There is NO default value
# and no fallback — docker-compose will refuse to start the `app` and `db`
# services until POSTGRES_PASSWORD is set here to a strong, unique value.
# Never commit your real .env file (it's already in .gitignore).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=school_db

# REQUIRE_POSTGRES: Set to "true" in production to enforce PostgreSQL-only operation.
# When enabled, the application will fail loudly and abort startup if PostgreSQL is unreachable (no SQLite fallback).
REQUIRE_POSTGRES=false

# DB_POOL_MAX: Maximum PostgreSQL client pool size (default: 15)
DB_POOL_MAX=15

# DB_POOL_MIN: Minimum PostgreSQL client pool size (default: 2)
DB_POOL_MIN=2

